# --- Standalone (ppe-runtime run) ---------------------------------------------
# PPE_CONFIG_DIR=/app/configs          # where default.yaml and sub-configs live
# PPE_CONFIG=/app/configs/default.yaml # top-level config file

# --- Managed by the Edge Agent (ppe-runtime agent) ----------------------------
# The agent injects these when it starts the container; set them by hand only for local testing.
RUNTIME_ID=local-dev-runtime
NODE_ID=local-dev-node
AGENT_URL=http://localhost:8081
# AGENT_API_KEY=
MODEL_PATH=/models/yolo26n.pt
# JSON; keys: source, target_fps, report_interval_sec, engine (name or mapping), tracking, conf, imgsz, ppe_rules
RUNTIME_CONFIG={"source": "0", "target_fps": 15, "conf": 0.25, "tracking": "bytetrack"}
LOG_LEVEL=INFO
